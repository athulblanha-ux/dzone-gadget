# DZONE GADGET Production Environment Variables Template
# Copy these values to your hosting provider's (Render/Vercel) Environment Variables section.

# ─── BACKEND (SERVER) ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dzone-gadget?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# Frontend URLs (for CORS)
FRONTEND_URL=https://your-client-domain.com
ADMIN_URL=https://your-admin-domain.com

# Cloudinary (Media Hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer / Mailtrap / SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="DZONE GADGET <no-reply@your-domain.com>"

# Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Payments (Stripe - Optional)
STRIPE_SECRET_KEY=sk_live_...


# ─── FRONTEND (CLIENT & ADMIN) ────────────────────────────────────────────────
# Use the URL of your deployed backend API
VITE_API_URL=https://your-backend-api.onrender.com/api
